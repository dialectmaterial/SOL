include README.md
recursive-include docs *.md
include pyproject.toml MANIFEST.in
recursive-include sol *.py
recursive-include tests *.py
exclude AGENTS.md
prune sources
prune local-corpus
prune local-corpus.building
prune local-corpus.building-*
prune .sol-corpus-work
prune .sol-extractions
prune .sol-ingest-work
prune .venv
prune build
prune dist
global-exclude *.pdf *.png *.jpg *.jpeg *.zip *.jsonl *.py[cod] *.sqlite3 *.sqlite3-* *.sol-workspace.json *.sol-workspace.md
