include README.md
include CONTRIBUTING.md CHANGELOG.md
recursive-include docs *.md
include docs/legacy/inventory.json
include pyproject.toml MANIFEST.in
recursive-include sol *.py *.lua
include sol/terminal/fonts/LibertinusMono-Regular.ttf sol/terminal/fonts/OFL.txt
include sol/essence/encyclopedia.json
include sol/essence/methods.json
recursive-include tests *.py
recursive-include scripts *.py
exclude AGENTS.md
prune sources
prune local-corpus
prune local-corpus.building
prune local-corpus.building-*
prune .sol-corpus-work
prune .sol-extractions
prune .sol-ingest-work
prune .venv
prune build
prune dist
global-exclude *.pdf *.png *.jpg *.jpeg *.zip *.jsonl *.py[cod] *.sqlite3 *.sqlite3-* *.sol-workspace.json *.sol-workspace.md *.sol-analysis.json
